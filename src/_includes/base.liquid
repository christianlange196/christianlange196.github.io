<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title and title != "" %}{{ title }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description | default: site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <!-- Set theme before paint to avoid a flash -->
  <script>
    (function () {
      try {
        var saved = localStorage.getItem("theme");
        var theme = saved || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      } catch (e) {}
    })();
  </script>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet">

  <!-- Styles -->
  <link rel="stylesheet" href="/assets/css/style.css">
  {% if extra_css %}<link rel="stylesheet" href="{{ extra_css }}">{% endif %}

  {% if useKatex %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
  {% endif %}
</head>
<body{% if body_class %} class="{{ body_class }}"{% endif %}>
  {% include "nav.liquid" %}

  <main{% if wide %} class="main-wide"{% endif %}>
    {{ content }}
  </main>

  {% include "footer.liquid" %}

  <script src="/assets/js/main.js"></script>
  {% if extra_js %}<script src="{{ extra_js }}"></script>{% endif %}
</body>
</html>
